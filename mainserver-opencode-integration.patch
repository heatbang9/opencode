+          }
+          draft.updatedAt = new Date()
+        }
+      )
+
+      // 파일 공유 이벤트 발행
+      Bus.publish("workspace.file_shared", {
+        workspaceId: input.workspaceId,
+        filePath,
+        sessionId: input.input.sessionId,
+        permissions: input.input.permissions,
